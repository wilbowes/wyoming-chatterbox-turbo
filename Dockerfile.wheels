# Chatterbox-Turbo behind Wyoming, for AMD and Intel GPUs (and CPU), from
# PyTorch's own wheels. BACKEND picks the wheel index:
#   rocm6.4  AMD Radeon / Instinct. The wheel carries the ROCm runtime; the
#            host needs only the amdgpu kernel driver (/dev/kfd, /dev/dri).
#   xpu      Intel Arc and Core Ultra graphics. The wheel carries the SYCL
#            runtime; the Level Zero GPU driver comes from Intel's Ubuntu PPA,
#            the source Intel documents for client GPUs.
#   cpu      no GPU. Several times slower than real time; for trying it out.
# The NVIDIA image is Dockerfile.
FROM ubuntu:24.04
ARG BACKEND=rocm6.4
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv libsndfile1 ffmpeg ca-certificates \
    && if [ "$BACKEND" = xpu ]; then \
         apt-get install -y --no-install-recommends software-properties-common gpg-agent \
         && add-apt-repository -y ppa:kobuk-team/intel-graphics \
         && apt-get install -y --no-install-recommends libze1 libze-intel-gpu1 intel-opencl-icd; \
       fi \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv
ENV PATH=/venv/bin:$PATH
COPY requirements.txt /app/requirements.txt
# torch first, from the backend's index; the rest after, so nothing pulls a
# CUDA torch from PyPI over it (the build fails below if something did).
RUN pip install torch==2.9.1 torchaudio==2.9.1 --index-url "https://download.pytorch.org/whl/${BACKEND}" \
    && pip install -r /app/requirements.txt && pip install --no-deps chatterbox-tts==0.1.7 \
    && python -c "import torch, sys; v = torch.__version__; print('torch', v); sys.exit(0 if v.endswith('+${BACKEND}') else 1)"
COPY shim.py /app/shim.py
ENTRYPOINT ["python", "/app/shim.py"]
